# Server
NODE_ENV="development"
HOST="0.0.0.0"
PORT="3333"
LOG_LEVEL="info"
# Guest mode is accepted only in development. Use true in test/staging/production.
AUTH_REQUIRED="false"

# Database
# Runtime connection used by Prisma Client / API queries.
# For Supabase, prefer the pooled URL here when the backend estiver rodando.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection used by Prisma migrations.
# For Supabase, use the non-pooled port here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase project
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Optional in Task 1, but expected for Task 3 if you validate JWT via JWKS fetch.
SUPABASE_JWKS_URL="https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json"

# Public API key used by the Auth server fallback and client login flows.
SUPABASE_PUBLISHABLE_KEY=""
# Legacy fallback while projects migrate to publishable keys.
SUPABASE_ANON_KEY=""

# Server-only. Never expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""
