{
  "name": "lootbook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "test:auth:e2e": "npm run build && node scripts/auth-e2e.mjs",
    "test:rls:e2e": "npm run build && node scripts/rls-e2e.mjs",
    "test:task5:e2e": "npm run build && node scripts/task5-e2e.mjs",
    "test:task6:e2e": "npm run build && node scripts/task6-e2e.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "all": "^0.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
